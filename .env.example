# Copy to .env (repo root) and fill in. On Vercel, set these in Project → Settings → Environment Variables.

# Neon Postgres (added automatically when you connect Neon through the Vercel Marketplace)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI — used for embeddings, NLU, eligibility screening and replies
OPENAI_API_KEY=sk-...

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Usernames that become admins when they register (comma-separated)
ADMIN_USERNAMES=

# Optional tuning
# OPENAI_MODEL=gpt-6-luna
# DAILY_MESSAGE_LIMIT=40
# RETRIEVAL_K=5
# MAX_COSINE_DISTANCE=0.55
